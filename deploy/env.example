# Copy this to .env.local in the repo root on the target machine and fill
# in real values. .env.local is gitignored — it will not come across when
# you copy the repo, create it fresh on each machine.

# Controls the visible page title only (e.g. "Acme Realty File Search").
NEXT_PUBLIC_ORG_NAME=YourCompany

# Absolute path to the READ-ONLY source drive/folder on this machine. Never
# written to — the crawler only ever reads from here.
SOURCE_DIR=D:\SourceFiles

# Absolute path to the flat pool folder ON THIS MACHINE (a normal read/write
# folder — this is where the crawler copies files TO).
POOL_DIR=C:\PoolFiles

GEMINI_API_KEY=

# GCP project. The same project can safely host multiple independent
# deployments (e.g. one per client) — just give each one its own Firestore
# collection and Vertex AI Search data store/engine below (see the two
# blocks that follow); their data never mixes.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to the service account key file — copy it to this machine separately
# (never commit it) and point here.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

FIRESTORE_COLLECTION=files

VERTEX_SEARCH_PROJECT=your-gcp-project-id
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_DATASTORE_ID=files-datastore
VERTEX_SEARCH_ENGINE_ID=files-search-app

# Optional — only set this if the crawler's Python venv lives somewhere
# other than <repo>/crawler/venv/Scripts/python.exe (the default the app
# assumes when the "Sync New Files" button spawns the crawler).
# CRAWLER_PYTHON_PATH=C:\FileSearch\crawler\venv\Scripts\python.exe

# --- Summarization provider ---
# "gemini-direct" (default) calls Gemini directly.
# "openrouter" routes through OpenRouter instead — often cheaper and faster
# for the same model, hardened against messy/corrupt files with timeouts,
# retries, and a self-healing render-worker pool. Automatically chunks and
# merges very large documents so nothing gets silently truncated. Confirm
# with a small real test on this machine before trusting it for a full run.
SUMMARY_PROVIDER=gemini-direct

# Required only when SUMMARY_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Optional — override the OpenRouter model (default is the standard tier).
# Do not add ":batch" — that requires a separate async batch-job API this
# code does not implement.
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional — number of PDF-rendering worker threads for the OpenRouter path
# (lib/renderPool.ts). Auto-sizes to this machine's CPU core count by
# default (capped at 16); override only if you need manual tuning.
# RENDER_POOL_SIZE=8
